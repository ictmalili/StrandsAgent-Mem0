# =========================================================
# LLM Provider — 用于 Strands Agent 主对话 & Mem0 事实抽取
# =========================================================
# 国内 (OpenAI 兼容): deepseek | qwen | zhipu | openai_compatible
# 海外:              openai (直连) | bedrock (需海外区 Bedrock 访问)
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# Bedrock 专用:调用区域 (仅 LLM_PROVIDER=bedrock 或 EMBEDDER_PROVIDER=bedrock 时生效)
# 常见: us-east-1 | us-west-2 | ap-northeast-1
BEDROCK_REGION=us-east-1

# =========================================================
# Embedding Provider — 用于 Mem0 向量化
# =========================================================
# 国内: qwen | zhipu | openai_compatible
# 海外: openai | bedrock
EMBEDDER_PROVIDER=qwen
EMBEDDER_API_KEY=sk-your-dashscope-api-key
EMBEDDER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDER_MODEL=text-embedding-v3
EMBEDDER_DIMS=1024

# =========================================================
# 快速切换预设 (取消对应段注释即可)
# =========================================================
# --- 预设 1: OpenAI 直连 (需要 OpenAI API Key) ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# EMBEDDER_PROVIDER=openai
# EMBEDDER_API_KEY=sk-...
# EMBEDDER_BASE_URL=https://api.openai.com/v1
# EMBEDDER_MODEL=text-embedding-3-small
# EMBEDDER_DIMS=1536

# --- 预设 2: 美东 Bedrock (需要 us-east-1 IAM 权限 + 已启用模型) ---
# LLM_PROVIDER=bedrock
# LLM_MODEL=anthropic.claude-sonnet-4-20250514-v1:0
# BEDROCK_REGION=us-east-1
# EMBEDDER_PROVIDER=bedrock
# EMBEDDER_MODEL=amazon.titan-embed-text-v2:0
# EMBEDDER_DIMS=1024

# =========================================================
# AWS 数据面 (S3 + Aurora / OpenSearch)
# =========================================================
# 中国区: cn-northwest-1 或 cn-north-1
# 海外区验证: us-east-1 等
AWS_REGION=cn-northwest-1
# 若用 IAM Role (EC2/ECS/Lambda 上运行时) 则留空
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# =========================================================
# 短期记忆 (Session 持久化)
# =========================================================
# s3 (生产/云上) | file (本地开发)
SESSION_BACKEND=s3
SESSION_S3_BUCKET=strands-mem0-sessions
SESSION_S3_PREFIX=sessions/
SESSION_FILE_DIR=./.sessions
CONVERSATION_WINDOW_SIZE=20

# =========================================================
# 长期记忆 (向量库)
# =========================================================
# pgvector (默认, Aurora PostgreSQL) | opensearch
VECTOR_STORE_PROVIDER=pgvector

# ---- pgvector / Aurora PostgreSQL ----
PGVECTOR_HOST=strands-mem0-pg.cluster-xxxxx.rds.amazonaws.com
PGVECTOR_PORT=5432
PGVECTOR_USER=postgres
# 注意: 密码只用字母数字。Mem0 pgvector 后端把密码拼进 PostgreSQL URI,
# 含 # ! @ / : ? & = % 等 URL 保留字符时会被截断导致认证失败。
PGVECTOR_PASSWORD=change-me-alphanumeric-only
PGVECTOR_DBNAME=mem0
PGVECTOR_COLLECTION=memories
PGVECTOR_SSLMODE=require
PGVECTOR_USE_HNSW=true

# ---- OpenSearch (可选备选) ----
OPENSEARCH_HOST=vpc-xxxxx.es.amazonaws.com
OPENSEARCH_PORT=443
OPENSEARCH_USE_SSL=true
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_AUTH_TYPE=basic
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=change-me
OPENSEARCH_INDEX=mem0_memories
